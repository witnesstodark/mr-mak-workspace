{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mr. Mak Workspace",
  "version": "0.4.17",
  "identifier": "com.mrmak.workspace",
  "build": {
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../desktop/splash"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../.cache/desktop-runtime/": "runtime/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
