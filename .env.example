# Optional voice connection. Terminal chats do not require this key.
OPENAI_API_KEY=

# Optional fal.ai generation account.
FAL_KEY=

# Optional coordinator model override; blank uses the Codex account default.
MRMAK_COORDINATOR_MODEL=

# Optional desktop/mobile dictation provider. Used only when you record and transcribe.
OPENROUTER_API_KEY=

# Optional dictation overrides: local, openrouter, openai, or off.
# Blank selects free local Whisper; cloud providers require explicit selection.
# A saved choice in Phone settings / Speech-to-text takes precedence.
MRMAK_TRANSCRIBE_PROVIDER=
# Blank uses openai/gpt-4o-transcribe (OpenRouter) or gpt-4o-transcribe (OpenAI).
MRMAK_TRANSCRIBE_MODEL=

# Optional paths to an installed local Whisper Python and model directory.
MRMAK_WHISPER_PYTHON=
MRMAK_WHISPER_MODEL=
