{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mrmak:asset-delivery:v1",
  "title": "Asset delivery file integrity manifest",
  "description": "Records local file identity only. It does not establish visual approval or engine readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "card_id", "step", "files"],
  "properties": {
    "schema": { "const": "mrmak.asset-delivery/v1" },
    "card_id": { "$ref": "#/$defs/id" },
    "step": { "$ref": "#/$defs/id" },
    "provider": { "$ref": "#/$defs/providerName" },
    "model": { "$ref": "#/$defs/providerName" },
    "receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "description": "A non-secret job identifier, never a URL, token or raw response."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["kind"],
        "properties": { "kind": { "const": "output" } }
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "kind", "sha256", "bytes"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Forward-slash path relative to the selected root. The CLI also resolves links and junctions."
          },
          "role": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["input", "output"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "providerName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,99}$"
    }
  }
}
